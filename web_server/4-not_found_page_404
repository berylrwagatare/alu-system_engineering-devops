#!/usr/bin/env bash
# Installs nginx with a 301 redirect and a custom 404 page
apt-get -y update
apt-get -y install nginx
echo "Holberton School" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html
sed -i 's|server_name _;|server_name _;\n\n\trewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;|' /etc/nginx/sites-available/default
sed -i 's|server_name _;|server_name _;\n\n\terror_page 404 /404.html;|' /etc/nginx/sites-available/default
service nginx restart
